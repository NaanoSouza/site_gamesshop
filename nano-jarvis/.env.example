# Copie para .env e ajuste. NUNCA commite o .env.

# Token do painel admin (mínimo 16 caracteres). Gere um: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Servidor
PORT=3780
HOST=127.0.0.1
# DB_PATH=./data/nano-jarvis.db

# Rotina diária (fuso da operação)
TZ_REGUA=America/Sao_Paulo
CRON_HOUR=9
CRON_MINUTE=0
SCHEDULER_ENABLED=true

# Regras de negócio
PROXY_PRICE_CENTS=1790
COUNT_BONUS_BALANCE=true
RECHARGE_LINK=https://app.ativosevo.com/recarga
# Contas a ignorar além das marcadas como admin/teste na fonte (separadas por vírgula)
IGNORE_EMAILS=
IGNORE_EMAIL_DOMAINS=
IGNORE_CLIENT_IDS=

# Fonte de dados: "demo" (fictícia). A fonte real da ProxysEvo ainda precisa ser plugada (src/source/README.md).
DATA_SOURCE=demo

# Canais: whatsapp e/ou email (e-mail é sempre simulado nesta fase)
CHANNELS=whatsapp,email
MAX_SEND_ATTEMPTS=3

# WhatsApp Cloud API (Meta). "simulado" = só registra no log e no banco. Troque para "real" só com tudo abaixo preenchido.
WHATSAPP_MODE=simulado
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_TEMPLATE_PREFIX=cobranca_
# Custo estimado por mensagem de utilidade, em centavos (ajuste pela tabela da Meta/BSP)
WHATSAPP_COST_CENTS=5
