# Configuração do Nano. O "Iniciar Nano" cria o .env a partir deste arquivo na primeira vez.
# Abra o .env no Bloco de Notas, ajuste e reinicie o Nano.

# Como o Nano te chama (ex.: SEU_NOME=Nano  →  "Bom dia, Nano!")
SEU_NOME=

# Pastas extras que você quer abrir por voz: nome=caminho, separados por ponto e vírgula.
# Downloads, Documentos, Área de trabalho, Imagens, Músicas e Vídeos já funcionam sem configurar.
# Ex.: PASTAS=trabalho=C:\Users\Voce\Trabalho;proxys=D:\ProxysEvo;fotos do evento=D:\Fotos\Evento
PASTAS=

# Sites extras: nome=endereço. Ex.: SITES=banco=https://www.seubanco.com.br;painel=https://app.ativosevo.com
SITES=

# Pasta com suas músicas (mp3, m4a, ogg, wav, flac). Com ela, o Nano toca, pausa e pula por voz.
# Ex.: MUSICA_DIR=C:\Users\Voce\Music
MUSICA_DIR=
# Música que não está na pasta abre no: youtube ou spotify (precisa do app do Spotify instalado)
MUSICA_ONLINE=youtube

# Cobranças: endereço e token do painel da régua (nano-jarvis), para "Nano, como estão as cobranças?"
# Ex.: REGUA_URL=https://regua.seudominio.com.br   REGUA_TOKEN=(o mesmo ADMIN_TOKEN da régua)
REGUA_URL=
REGUA_TOKEN=

# Conversa livre com o Claude (opcional): responde perguntas que não são comandos.
# Crie uma chave em https://platform.claude.com e cole aqui. Sem chave, o Nano só entende os comandos.
ANTHROPIC_API_KEY=
# NANO_MODELO=claude-opus-5-5

# Porta local (só mude se a 3790 estiver ocupada; aí ajuste também o "Iniciar Nano")
PORT=3790
